<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= appName %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/">🔨 <%= appName %></a>
    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-outline-light btn-sm" href="/items">Semua Jasa</a>

      <% if (currentUser && currentUser.role === 'seller') { %>
        <a class="btn btn-outline-light btn-sm" href="/seller/items">Kelola Jasa</a>
      <% } %>

      <% if (currentUser && currentUser.role === 'buyer') { %>
        <a class="btn btn-outline-light btn-sm" href="/bookings">Pesanan Saya</a>
      <% } %>

      <% if (currentUser) { %>
        <span class="text-white small">Halo, <%= currentUser.username %></span>
        <form action="/logout" method="POST" class="m-0">
          <button class="btn btn-danger btn-sm">Logout</button>
        </form>
      <% } else { %>
        <a class="btn btn-warning btn-sm" href="/login">Login</a>
        <a class="btn btn-light btn-sm" href="/register">Register</a>
      <% } %>
    </div>
  </div>
</nav>