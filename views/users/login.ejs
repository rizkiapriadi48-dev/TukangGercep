<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | Tukang Gercep</title>
</head>

<body style="font-family: Arial, sans-serif; background-color: whitesmoke; margin: 0; padding: 0;">

    <div style="background-color: white; width: 320px; margin: 100px auto; padding: 25px; border-radius: 8px;">

        <h1 style="text-align: center; color: forestgreen;">
            Tukang Gercep
        </h1>

        <p style="text-align: center; color: dimgray;">
            Silakan login ke akun kamu
        </p>

        <% if (typeof success !== 'undefined' && success) { %>
            <p style="background-color: honeydew; color: darkgreen; padding: 10px;">
                <%= success %>
            </p>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <p style="background-color: mistyrose; color: darkred; padding: 10px;">
                <%= error %>
            </p>
        <% } %>

        <form action="/login" method="POST">

            <label for="email">Email</label>
            <input
                type="email"
                id="email"
                name="email"
                placeholder="Masukkan email"
                required
                style="width: 100%; padding: 10px; margin: 8px 0; box-sizing: border-box;"
            >

            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                placeholder="Masukkan password"
                required
                style="width: 100%; padding: 10px; margin: 8px 0; box-sizing: border-box;"
            >

            <button
                type="submit"
                style="width: 100%; padding: 10px; margin-top: 15px; background-color: forestgreen; color: white; border: none; border-radius: 4px; cursor: pointer;"
            >
                Login
            </button>

        </form>

        <p style="text-align: center;">
            Belum punya akun?
            <a href="/register" style="color: forestgreen; text-decoration: none;">
                Daftar di sini
            </a>
        </p>

        <p style="text-align: center;">
            <a href="/" style="color: dimgray; text-decoration: none;">
                Kembali ke beranda
            </a>
        </p>

    </div>

</body>
</html>